<% layout("layout/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <h3>Create a new Listing</h3>

            <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" placeholder="Hotel" type="text" class="form-control" required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control" required></textarea>
                    <div id="validationServerUsernameFeedback" class="invalid-feedback">
                        Please enter a short description.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload Image</label>
                    <input name="listing[image][url]" class="form-control" type="file">
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" placeholder="1600" class="form-control" type="number" required>
                        <div id="validationServerUsernameFeedback" class="invalid-feedback">
                            Please enter a valid price.
                        </div>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label for="location" class="form-label">Location</label>
                        <input name="listing[location]" placeholder="Karachi" class="form-control" type="text" required>
                        <div id="validationServerUsernameFeedback" class="invalid-feedback">
                            Please enter a location.
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="country" class="form-label">Country</label>
                    <input name="listing[country]" placeholder="Pakistan" class="form-control" type="text" required>
                    <div id="validationServerUsernameFeedback" class="invalid-feedback">
                        Please enter a country.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <select name="listing[category]" class="form-control" required>
                        <option value="" disabled selected>Choose a category</option>
                        <option value="trending">Trending</option>
                        <option value="rooms">Rooms</option>
                        <option value="iconic-cities">Iconic Cities</option>
                        <option value="camping">Camping</option>
                        <option value="mountains">Mountains</option>
                        <option value="beach">Beach</option>
                        <option value="pools">Pools</option>
                        <option value="farms">Farms</option>
                        <option value="arctic">Arctic</option>
                        <option value="ferry">Ferry</option>
                        <option value="domes">Domes</option>
                        <option value="igloos">Igloos</option>
                    </select>
                    <div id="validationServerUsernameFeedback" class="invalid-feedback">
                        Please choose a category.
                    </div>
                </div>
                <br>
                <button class="btn btn-dark add-btn">Add</button>
                <br><br>
            </form>
        </div>
    </div>